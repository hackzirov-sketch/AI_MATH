# ── Telegram Bot ───────────────────────────────────────────────────────────────
# BotFather dan olingan token
BOT_TOKEN=1234567890:AAF_your_bot_token_here

# Admin Telegram ID lari (vergul bilan ajratiing, bo'sh joy yo'q)
# O'z ID ingizni bilish uchun @userinfobot ga yozing
ADMIN_IDS=123456789,987654321
TEACHER_USERNAME=@teacher_username
CHANNEL_ID=@kanal_nomi

# ── Flask Web Panel ────────────────────────────────────────────────────────────
# Tasodifiy, uzun string (python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change-this-to-a-random-secret-string

# Web panel port (Render/Railway avtomatik o'rnatadi)
PORT=5000

# ── Ma'lumotlar bazasi ─────────────────────────────────────────────────────────
# Bo'sh qoldirsangiz — SQLite (database.db) ishlatiladi
# PostgreSQL uchun: postgresql://user:password@host:5432/dbname
DATABASE_URL=
REDIS_URL=
CELERY_RESULT_BACKEND=

# ── Webhook (ixtiyoriy) ────────────────────────────────────────────────────────
# Production da polling o'rniga webhook ishlatish uchun (render.com URL)
# Bo'sh qolsa — polling rejimi ishlatiladi
WEBHOOK_URL=
# Webhook yo'li (odatda /webhook)
WEBHOOK_PATH=/webhook
# Webhook maxfiy token (ixtiyoriy, xavfsizlik uchun)
WEBHOOK_SECRET=

# ── Sentry (xatolarni kuzatish, ixtiyoriy) ────────────────────────────────────
# https://sentry.io dan DSN oling
# Bo'sh qolsa — Sentry o'chirilgan
SENTRY_DSN=

# ── HuggingFace (rasm generatsiya, ixtiyoriy) ─────────────────────────────────
# API kalitlarini web paneldan ham qo'shish mumkin
# HF_TOKEN=hf_your_token_here
OPENROUTER_API_KEYS=
CEREBRAS_API_KEYS=
SAMBANOVA_API_KEYS=
HUGGINGFACE_API_KEYS=
GROQ_API_KEYS=

# Serper internet qidiruvi uchun
SERPER_API_KEY=

ENVIRONMENT=development
APP_TIMEZONE=Asia/Tashkent
RUN_MODE=combined
CACHE_CLEAN_INTERVAL_SECONDS=600
AI_MATH_RENDER_MAX_WORKERS=2
AI_MATH_RENDER_SOFT_LIMIT_MB=192
AI_MATH_RENDER_HARD_LIMIT_MB=256
DAILY_CONTENT_HOUR=9
DAILY_CONTENT_MINUTE=0
WIKIMEDIA_USER_AGENT=AI_MATH/1.0 (educational mathematics bot; contact: admin@example.com)
